local httpService = game:GetService('HttpService')

local SaveManager = {} do
	SaveManager.Folder = 'LinoriaLibSettings'
	SaveManager.Ignore = {}
	SaveManager.AutoloadLabel = nil

	local function NormalizeConfigName(name)
		if type(name) ~= 'string' then return nil end
		local clean = name:gsub('%s+', '')
		if clean:sub(-5):lower() == '.json' then
			clean = clean:sub(1, -6)
		end
		if clean == '' then return nil end
		return clean
	end

	-- robust string split fallback if :split not available
	local function split(str, delim)
		if str.split then
			local ok, res = pcall(function() return str:split(delim) end)
			if ok and type(res) == 'table' then return res end
		end
		local out = {}
		for part in string.gmatch(str, "[^"..delim.."]+") do
			table.insert(out, part)
		end
		return out
	end

	local function getToggles()
		if getgenv then
			local ok, t = pcall(getgenv)
			if ok and type(t) == 'table' and t.Toggles then return t.Toggles end
		end
		if getgenv and getgenv().Toggles then return getgenv().Toggles end
		if _G and _G.Toggles then return _G.Toggles end
		return Toggles
	end

	local function getOptions()
		if getgenv then
			local ok, t = pcall(getgenv)
			if ok and type(t) == 'table' and t.Options then return t.Options end
		end
		if getgenv and getgenv().Options then return getgenv().Options end
		if _G and _G.Options then return _G.Options end
		return Options
	end

	SaveManager.Parser = {
		Toggle = {
			Save = function(idx, object) 
				-- ensure boolean
				local v = object.Value
				if type(v) ~= "boolean" then v = not not v end
				return { type = "Toggle", idx = idx, value = v } 
			end,
			Load = function(idx, data)
				local function findToggle(key)
					local cands = {}
					local t = getToggles(); if t then table.insert(cands, t) end
					local o = getOptions(); if o and o ~= t then table.insert(cands, o) end
					if Toggles and Toggles ~= t then table.insert(cands, Toggles) end
					if Options and Options ~= o then table.insert(cands, Options) end
					for _,tbl in ipairs(cands) do
						if tbl[key] then return tbl[key] end
					end
					local low = key:lower()
					for _,tbl in ipairs(cands) do
						for k,v in pairs(tbl) do
							if type(k)=="string" and k:lower()==low and v and v.Type=="Toggle" then return v end
						end
					end
					return nil
				end
				local obj = findToggle(idx)
				if obj then
					local v = data.value
					if type(v) == "string" then
						local low = v:lower()
						if low == "true" or low == "1" then v = true
						elseif low == "false" or low == "0" then v = false
						else v = not not v end
					elseif type(v) == "number" then
						v = v ~= 0
					elseif type(v) ~= "boolean" then
						v = v and true or false
					end
					local ok = pcall(function() obj:SetValue(v) end)
					if not ok then
						pcall(function()
							obj.Value = v
							if obj.Display then obj:Display() end
						end)
					end
					if obj.Value ~= v then
						obj.Value = v
						pcall(function() if obj.Display then obj:Display() end end)
					end
				end
			end,
		},
		Slider = {
			Save = function(idx, object)
				return { type = 'Slider', idx = idx, value = tostring(object.Value) }
			end,
			Load = function(idx, data)
				local o = getOptions()
				local t = getToggles()
				local obj = (o and o[idx]) or (t and t[idx]) or (Options and Options[idx]) or (Toggles and Toggles[idx])
				if obj and obj.SetValue then
					local v = data.value
					if v ~= nil then
						pcall(function() obj:SetValue(v) end)
					end
				end
			end,
		},
		Dropdown = {
			Save = function(idx, object)
				return { type = 'Dropdown', idx = idx, value = object.Value, multi = object.Multi }
			end,
			Load = function(idx, data)
				local o = getOptions()
				local t = getToggles()
				local obj = (o and o[idx]) or (t and t[idx]) or (Options and Options[idx]) or (Toggles and Toggles[idx])
				if obj and obj.SetValue and data.value ~= nil then
					pcall(function() obj:SetValue(data.value) end)
				end
			end,
		},
		ColorPicker = {
			Save = function(idx, object)
				local hex = ''
				pcall(function() hex = object.Value:ToHex() end)
				return { type = 'ColorPicker', idx = idx, value = hex, transparency = object.Transparency }
			end,
			Load = function(idx, data)
				local o = getOptions()
				local obj = (o and o[idx]) or (Options and Options[idx])
				if obj and type(data.value) == 'string' then
					local ok, col = pcall(Color3.fromHex, data.value)
					if ok and typeof(col) == 'Color3' then
						pcall(function() obj:SetValueRGB(col, tonumber(data.transparency) or 0) end)
					end
				end
			end,
		},
		KeyPicker = {
			Save = function(idx, object)
				local mode = object.Mode
				if type(mode) ~= 'string' then mode = 'Toggle' end
				local key = object.Value
				if type(key) ~= 'string' or key == '' then key = 'None' end
				return { type = 'KeyPicker', idx = idx, mode = mode, key = key }
			end,
			Load = function(idx, data)
				local o = getOptions()
				local obj = (o and o[idx]) or (Options and Options[idx])
				if obj and type(data) == 'table' and type(data.key) == 'string' then
					local mode = data.mode
					if type(mode) ~= 'string' then mode = 'Toggle' end
					pcall(function() obj:SetValue({ data.key, mode }) end)
				end
			end,
		},

		Input = {
			Save = function(idx, object)
				return { type = 'Input', idx = idx, text = object.Value }
			end,
			Load = function(idx, data)
				local o = getOptions()
				local obj = (o and o[idx]) or (Options and Options[idx])
				if obj and type(data.text) == 'string' then
					pcall(function() obj:SetValue(data.text) end)
				end
			end,
		},
	}

	function SaveManager:SetIgnoreIndexes(list)
		for _, key in next, list do
			self.Ignore[key] = true
		end
	end

	function SaveManager:SetFolder(folder)
		self.Folder = folder;
		self:BuildFolderTree()
	end

	function SaveManager:Save(name)
		local clean = NormalizeConfigName(name)
		if (not clean) then
			return false, 'no config file is selected'
		end

		local fullPath = self.Folder .. '/settings/' .. clean .. '.json'

		local data = {
			objects = {}
		}

		local allToggles = getToggles()
		local allOptions = getOptions()
		-- save toggles - be permissive: if it has Value and Type is Toggle-ish
		if allToggles then
			for idx, toggle in next, allToggles do
				if self.Ignore[idx] then continue end
				if toggle and type(toggle) == 'table' then
					local typ = toggle.Type
					-- allow missing Type if idx looks like toggle (has Value boolean)
					if typ == "Toggle" or (typ == nil and type(toggle.Value) == 'boolean' and toggle.SetValue) then
						typ = "Toggle"
					end
					if typ and self.Parser[typ] then
						local ok, result = pcall(self.Parser[typ].Save, idx, toggle)
						if ok and result then
							table.insert(data.objects, result)
						end
					end
				end
			end
		end

		if allOptions then
			for idx, option in next, allOptions do
				if self.Ignore[idx] then continue end
				if option and type(option) == 'table' and option.Type then
					if self.Parser[option.Type] then
						local ok, result = pcall(self.Parser[option.Type].Save, idx, option)
						if ok and result then
							table.insert(data.objects, result)
						end
					end
				end
			end
		end

		-- also check global fallbacks in case getgenv desync
		if Toggles and Toggles ~= allToggles then
			for idx, toggle in next, Toggles do
				if self.Ignore[idx] then continue end
				if toggle and toggle.Type == "Toggle" and not allToggles[idx] then
					local ok, result = pcall(self.Parser[toggle.Type].Save, idx, toggle)
					if ok and result then table.insert(data.objects, result) end
				end
			end
		end
		if Options and Options ~= allOptions then
			for idx, option in next, Options do
				if self.Ignore[idx] then continue end
				if option and self.Parser[option.Type] and not allOptions[idx] then
					local ok, result = pcall(self.Parser[option.Type].Save, idx, option)
					if ok and result then table.insert(data.objects, result) end
				end
			end
		end

		local success, encoded = pcall(httpService.JSONEncode, httpService, data)
		if not success then
			return false, 'failed to encode data'
		end

		-- ensure folder exists before write
		pcall(function() self:BuildFolderTree() end)

		local ok, err = pcall(writefile, fullPath, encoded)
		if not ok then return false, 'writefile failed: '..tostring(err) end
		return true
	end

	function SaveManager:Load(name)
		local clean = NormalizeConfigName(name)
		if (not clean) then
			return false, 'no config file is selected'
		end

		local file = self.Folder .. '/settings/' .. clean .. '.json'
		if not isfile(file) then
			local alt = 'PhowgHosted/DaHood/settings/'..clean..'.json'
			if isfile(alt) then file = alt else return false, 'invalid file' end
		end

		local success, decoded = pcall(httpService.JSONDecode, httpService, readfile(file))
		if not success then return false, 'decode error' end
		if type(decoded) ~= 'table' or type(decoded.objects) ~= 'table' then return false, 'decode error' end

		-- suppress autosave while loading to prevent overwriting with partial state
		local prevSuppress = Library and Library.SuppressSave
		if Library then Library.SuppressSave = true end
		-- use robust loader that directly calls parser (parser does its own lookup + case-insensitive)
		for _, option in next, decoded.objects do
			if type(option) == 'table' and option.type and self.Parser[option.type] then
				local optType = option.type
				local optIdx = option.idx
				local optData = option
				if type(optIdx) ~= 'string' then continue end
				-- always try immediate load, parser handles missing via internal find
				local ok, err = pcall(function() self.Parser[optType].Load(optIdx, optData) end)
				if not ok then
					warn("[SaveManager] Load error for "..tostring(optIdx)..": "..tostring(err))
				end
				-- if still not applied, retry for late-created elements
				-- check if value actually applied
				task.spawn(function()
					for _ = 1, 100 do
						local at = getToggles()
								local ao = getOptions()
								t = (ao and ao[optIdx]) or (at and at[optIdx]) or (Options and Options[optIdx]) or (Toggles and Toggles[optIdx])
							end
							if t ~= nil then
								pcall(function() self.Parser[optType].Load(optIdx, optData) end)
								break
							end
							task.wait(0.1)
						end
					end)
				end
			end
		end
		task.spawn(function()
			task.wait(0.5)
			local at = getToggles()
			if at and at["visualize_ammo"] and at["visualize_ammo"].Value then
				pcall(function() Func["updateammodisplay"]() end)
			elseif Toggles and Toggles["visualize_ammo"] and Toggles["visualize_ammo"].Value then
				pcall(function() Func["updateammodisplay"]() end)
			end
			pcall(function() if Library and Library.UpdateDependencyBoxes then Library:UpdateDependencyBoxes() end end)
		end)
		return true
	end

	function SaveManager:IgnoreThemeSettings()
		self:SetIgnoreIndexes({ 
			"BackgroundColor", "MainColor", "AccentColor", "OutlineColor", "FontColor", -- themes
			"ThemeManager_ThemeList", 'ThemeManager_CustomThemeList', 'ThemeManager_CustomThemeName', -- themes
		})
	end

	function SaveManager:BuildFolderTree()
		local parts = split(self.Folder, '/')
		local paths = {}
		for idx = 1, #parts do
			paths[#paths + 1] = table.concat(parts, '/', 1, idx)
		end
		table.insert(paths, self.Folder .. '/themes')
		table.insert(paths, self.Folder .. '/settings')

		for i = 1, #paths do
			local str = paths[i]
			local ok, isDir = pcall(isfolder, str)
			if ok and not isDir then
				pcall(makefolder, str)
			elseif not ok then
				pcall(makefolder, str)
			end
		end
	end

	function SaveManager:RefreshConfigList()
		local ok, list = pcall(listfiles, self.Folder .. '/settings')
		if not ok or type(list) ~= 'table' then return {} end

		local out = {}
		for i = 1, #list do
			local file = list[i]
			if type(file) == 'string' and file:sub(-5) == '.json' then
				local pos = file:find('.json', 1, true)
				local start = pos
				local char = file:sub(pos, pos)
				while char ~= '/' and char ~= '\\' and char ~= '' do
					pos = pos - 1
					if pos < 1 then break end
					char = file:sub(pos, pos)
				end

				if char == '/' or char == '\\' then
					table.insert(out, file:sub(pos + 1, start - 1))
				else
					-- fallback: file has no directory component
					local name = file:sub(1, start - 1)
					-- strip any leading path weirdness
					name = name:match("([^/\\]+)$") or name
					table.insert(out, name)
				end
			end
		end
		
		return out
	end

	function SaveManager:SetLibrary(library)
		self.Library = library
		library.SaveManager = self
		if getgenv then pcall(function() getgenv().SaveManager = self end) end
		if _G then pcall(function() _G.SaveManager = self end) end
	end

	function SaveManager:LoadAutoloadConfig()
		task.spawn(function()
			for _ = 1, 100 do
				local t = getToggles()
				local o = getOptions()
				local hasToggle = (t and t["visualize_ammo"] ~= nil) or (Toggles and Toggles["visualize_ammo"] ~= nil)
				local hasOpt = (o and o["SaveManager_ConfigList"] ~= nil) or (Options and Options["SaveManager_ConfigList"] ~= nil)
				if hasToggle and hasOpt then break end
				task.wait(0.1)
			end
			local ok, isFile = pcall(isfile, self.Folder .. '/settings/autoload.txt')
			if not ok or not isFile then return end
			local okRead, name = pcall(readfile, self.Folder .. '/settings/autoload.txt')
			if not okRead then return end
			local clean = NormalizeConfigName(name)
			if not clean then return end
			local success, err = self:Load(clean)
			if not success then
				return self.Library:Notify('Failed to load autoload config: ' .. tostring(err))
			end
			self.Library:Notify(string.format('Auto loaded config %q', clean))
		end)
	end


	function SaveManager:BuildConfigSection(tab)
		assert(self.Library, 'Must set SaveManager.Library')

		local section = tab:AddRightGroupbox('Configuration')

		section:AddInput('SaveManager_ConfigName',    { Text = 'Config name' })
		section:AddDropdown('SaveManager_ConfigList', { Text = 'Config list', Values = self:RefreshConfigList(), AllowNull = true })

		section:AddDivider()

		section:AddButton('Create config', function()
			local name = getOptions().SaveManager_ConfigName and getOptions().SaveManager_ConfigName.Value or (Options.SaveManager_ConfigName and Options.SaveManager_ConfigName.Value)
			local clean = NormalizeConfigName(name)

			if not clean then
				return self.Library:Notify('Invalid config name (empty)', 2)
			end

			local success, err = self:Save(clean)
			if not success then
				return self.Library:Notify('Failed to save config: ' .. tostring(err))
			end

			self.Library:Notify(string.format('Created config %q', clean))

			local opts = getOptions()
			if opts.SaveManager_ConfigList then
				opts.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
				opts.SaveManager_ConfigList:SetValue(nil)
			elseif Options.SaveManager_ConfigList then
				Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
				Options.SaveManager_ConfigList:SetValue(nil)
			end
		end):AddButton('Load config', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigList and opts.SaveManager_ConfigList.Value) or (Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value)

			local success, err = self:Load(name)
			if not success then
				return self.Library:Notify('Failed to load config: ' .. tostring(err))
			end

			self.Library:Notify(string.format('Loaded config %q', tostring(name)))
		end)

		section:AddButton('Overwrite config', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigList and opts.SaveManager_ConfigList.Value) or (Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value)

			local success, err = self:Save(name)
			if not success then
				return self.Library:Notify('Failed to overwrite config: ' .. tostring(err))
			end

			self.Library:Notify(string.format('Overwrote config %q', tostring(name)))
		end)

		section:AddButton('Refresh list', function()
			local opts = getOptions()
			local target = opts.SaveManager_ConfigList or Options.SaveManager_ConfigList
			if target then
				target:SetValues(self:RefreshConfigList())
				target:SetValue(nil)
			end
		end)

		section:AddButton('Set as autoload', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigList and opts.SaveManager_ConfigList.Value) or (Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value)
			local clean = NormalizeConfigName(name)
			if not clean then
				return self.Library:Notify('Select a config first', 2)
			end
			writefile(self.Folder .. '/settings/autoload.txt', clean)
			if SaveManager.AutoloadLabel then
				SaveManager.AutoloadLabel:SetText('Current autoload config: ' .. clean)
			end
			self.Library:Notify(string.format('Set %q to auto load', clean))
		end)

		SaveManager.AutoloadLabel = section:AddLabel('Current autoload config: none', true)

		local okFile, isFile = pcall(isfile, self.Folder .. '/settings/autoload.txt')
		if okFile and isFile then
			local okRead, name = pcall(readfile, self.Folder .. '/settings/autoload.txt')
			if okRead then
				local clean = NormalizeConfigName(name)
				if clean then
					SaveManager.AutoloadLabel:SetText('Current autoload config: ' .. clean)
				end
			end
		end

		SaveManager:SetIgnoreIndexes({ 'SaveManager_ConfigList', 'SaveManager_ConfigName' })
	end

	SaveManager:BuildFolderTree()
end

return SaveManager
