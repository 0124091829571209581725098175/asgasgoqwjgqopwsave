local httpService = game:GetService('HttpService')

local SaveManager = {} do
	SaveManager.Folder = 'LinoriaLibSettings'
	SaveManager.Ignore = {}
	SaveManager.AutoloadLabel = nil
	SaveManager.Library = nil
	SaveManager.PhowgRevision = 4
	SaveManager.SchemaVersion = 1
	SaveManager.IndexAliases = {}
    SaveManager.States = {}
    function SaveManager:RegisterState(idx, capture, apply, category)
        assert(type(idx) == 'string' and type(capture) == 'function' and type(apply) == 'function', 'invalid persistent state')
        self.States[idx] = {Capture = capture, Apply = apply, Category = category or self:GetCategory(idx)}
    end
	SaveManager.Migrations = {
		[0] = function(data)
			data.schemaVersion = 1
			return data
		end
	}
	function SaveManager:SetIndexAliases(aliases)
		for oldIndex, newIndex in pairs(aliases) do
			if type(oldIndex) == 'string' and type(newIndex) == 'string' then self.IndexAliases[oldIndex] = newIndex end
		end
	end
	function SaveManager:Migrate(data)
		if type(data) ~= 'table' or type(data.objects) ~= 'table' then return nil, 'invalid config data' end
		local version = data.schemaVersion
		if version == nil then version = 0 end
		if type(version) ~= 'number' or version < 0 or version % 1 ~= 0 then return nil, 'invalid schema version' end
		if version > self.SchemaVersion then return nil, 'config requires a newer script version' end
		data = table.clone(data)
		while version < self.SchemaVersion do
			local migration = self.Migrations[version]
			if not migration then return nil, 'missing config migration' end
			local ok, result = pcall(migration, data)
			if not ok or type(result) ~= 'table' or result.schemaVersion ~= version + 1 or type(result.objects) ~= 'table' then return nil, 'config migration failed' end
			data = result
			version += 1
		end
		local objects = {}
		for _, object in pairs(data.objects) do
			if type(object) == 'table' then
				local copy = table.clone(object)
				if type(copy.idx) == 'string' then copy.idx = self.IndexAliases[copy.idx] or copy.idx end
				table.insert(objects, copy)
			end
		end
		data.objects = objects
		return data
	end

	local function NormalizeConfigName(name)
		if type(name) ~= 'string' then return nil end
		local clean = name:gsub('%s+', '')
		if clean:sub(-5):lower() == '.json' then
			clean = clean:sub(1, -6)
		end
		if clean == '' or #clean > 96 or (clean:find('/',1,true) or clean:find('\\',1,true) or clean:find('[:%c]')) or clean:find('..', 1, true) then return nil end
		return clean
	end

	local function split(str, delim)
		if str.split then
			local ok, res = pcall(function() return str:split(delim) end)
			if ok and type(res) == 'table' then return res end
		end
		local out = {}
		for part in string.gmatch(str, "[^"..delim.."]+") do
			table.insert(out, part)
		end
		return out
	end

	local function getToggles()
		if SaveManager.Library and SaveManager.Library.Toggles then return SaveManager.Library.Toggles end
		if getgenv then
			local ok, t = pcall(getgenv)
			if ok and type(t) == 'table' and t.Toggles then return t.Toggles end
		end
		if getgenv and getgenv().Toggles then return getgenv().Toggles end
		if _G and _G.Toggles then return _G.Toggles end
		return (SaveManager.Library and SaveManager.Library.Toggles) or Toggles
	end

	local function getOptions()
		if SaveManager.Library and SaveManager.Library.Options then return SaveManager.Library.Options end
		if getgenv then
			local ok, t = pcall(getgenv)
			if ok and type(t) == 'table' and t.Options then return t.Options end
		end
		if getgenv and getgenv().Options then return getgenv().Options end
		if _G and _G.Options then return _G.Options end
		return (SaveManager.Library and SaveManager.Library.Options) or Options
	end

	local function getControls()
		local controls = {}
		for _, source in ipairs({getToggles() or {}, getOptions() or {}}) do
			for idx, control in pairs(source) do
				if type(idx) == 'string' and type(control) == 'table' then controls[idx] = control end
			end
		end
		local registry = SaveManager.Library and SaveManager.Library.ControlRegistry
		for idx, entry in pairs(registry or {}) do
			if type(idx) == 'string' and type(entry.Control) == 'table' then controls[idx] = entry.Control end
		end
		return controls
	end
	local function findControl(idx)
		local registry = SaveManager.Library and SaveManager.Library.ControlRegistry
		local entry = registry and registry[idx]
		return (entry and entry.Control) or (getToggles() or {})[idx] or (getOptions() or {})[idx]
	end
	SaveManager.Parser = {
		Toggle = {
			Save = function(idx, object) 
				local v = object.Value
				if type(v) ~= "boolean" then v = not not v end
				return { type = "Toggle", idx = idx, value = v } 
			end,
			Load = function(idx, data)
				local function findToggle(key)
					local cands = {}
					local lib = SaveManager.Library
					if lib and lib.Toggles then table.insert(cands, lib.Toggles) end
					local t = getToggles(); if t and t ~= (lib and lib.Toggles) then table.insert(cands, t) end
					local o = getOptions(); if o and o ~= t then table.insert(cands, o) end
					if Toggles and Toggles ~= t then table.insert(cands, Toggles) end
					if Options and Options ~= o then table.insert(cands, Options) end

					for _, tbl in ipairs(cands) do
						if tbl[key] then return tbl[key] end
					end

					local low = key:lower()
					for _, tbl in ipairs(cands) do
						for k, v in pairs(tbl) do
							if type(k) == "string" and k:lower() == low and v and (v.Type == "Toggle" or v.SetValue) then
								return v
							end
						end
					end
					return nil
				end

				local obj = findToggle(idx)
				obj = findControl(idx) or obj
				if obj then
					local v = data.value
					if type(v) == "string" then
						local low = v:lower()
						if low == "true" or low == "1" then v = true
						elseif low == "false" or low == "0" then v = false
						else v = not not v end
					elseif type(v) == "number" then
						v = v ~= 0
					elseif type(v) ~= "boolean" then
						v = not not v
					end

					if obj.SetValue then
						obj:SetValue(v)
					else
						obj.Value = v
						if obj.Display then pcall(function() obj:Display() end) end
					end

					if obj.Value ~= v then
						obj.Value = v
						if obj.Display then pcall(function() obj:Display() end) end
					end
				end
			end,
		},
		Slider = {
			Save = function(idx, object)
				return { type = 'Slider', idx = idx, value = tostring(object.Value) }
			end,
			Load = function(idx, data)
				local obj = findControl(idx)
				if obj and obj.SetValue then
					local v = tonumber(data.value) or data.value
					if v ~= nil then
						obj:SetValue(v)
					end
				end
			end,
		},
		Dropdown = {
			Save = function(idx, object)
				return { type = 'Dropdown', idx = idx, value = type(object.Value) == 'table' and table.clone(object.Value) or object.Value, multi = object.Multi }
			end,
			Load = function(idx, data)
				local obj = findControl(idx)
				if obj and obj.SetValue then
					obj:SetValue(data.value)
				end
			end,
		},
		ColorPicker = {
			Save = function(idx, object)
				local color = object.RgbEnabled and object.OriginalValue or object.Value
				return { type = 'ColorPicker', idx = idx, value = color:ToHex(), transparency = object.RgbEnabled and object.OriginalTransparency or object.Transparency, rgb = object.RgbEnabled == true, chromaSpeed = object.ChromaSpeed or 1 }
			end,
			Load = function(idx, data)
				local obj = findControl(idx)
				if obj and type(data.value) == 'string' then
					local ok, col = pcall(Color3.fromHex, data.value)
					if ok and typeof(col) == 'Color3' then
						local library = SaveManager.Library
						if library and library.SetChromaEnabled then library:SetChromaEnabled(obj, false) end
						obj:SetValueRGB(col, tonumber(data.transparency) or 0)
						obj.ChromaSpeed = math.clamp(tonumber(data.chromaSpeed) or 1, 1, 5)
						if obj.UpdateChromaSpeed then obj.UpdateChromaSpeed() end
						if library and library.SetChromaEnabled then library:SetChromaEnabled(obj, data.rgb == true) end
					end
				end
			end,
		},
		KeyPicker = {
			Save = function(idx, object)
				local mode = object.Mode
				if type(mode) ~= 'string' then mode = 'Toggle' end
				local key = object.Value
				if type(key) ~= 'string' or key == '' then key = 'None' end
				return { type = 'KeyPicker', idx = idx, mode = mode, key = key }
			end,
			Load = function(idx, data)
				local obj = findControl(idx)
				if obj and type(data) == 'table' and type(data.key) == 'string' then
					local mode = data.mode
					if type(mode) ~= 'string' then mode = 'Toggle' end
					obj:SetValue({ data.key, mode })
				end
			end,
		},
		Input = {
			Save = function(idx, object)
				return { type = 'Input', idx = idx, text = object.Value }
			end,
			Load = function(idx, data)
				local obj = findControl(idx)
				if obj and type(data.text) == 'string' then
					obj:SetValue(data.text)
				end
			end,
		},
	}

	function SaveManager:SetIgnoreIndexes(list)
		for _, key in next, list do
			self.Ignore[key] = true
		end
	end

	function SaveManager:SetFolder(folder)
		self.Folder = folder
		self:BuildFolderTree()
	end

    function SaveManager:CaptureCurrent()
        local data, failures = {schemaVersion = self.SchemaVersion, objects = {}, states = {}}, {}
        for idx, control in pairs(getControls()) do
            local parser = type(control) == 'table' and self.Parser[control.Type]
            if not self.Ignore[idx] then
                if not parser then failures[#failures + 1] = idx .. ': unsupported control type'; continue end
                local ok, object = pcall(parser.Save, idx, control)
                if ok and type(object) == 'table' then
                    local entry = self.Library and self.Library.ControlRegistry and self.Library.ControlRegistry[idx]
                    object.category = entry and entry.Category or self:GetCategory(idx)
                    data.objects[#data.objects + 1] = object
                else
                    failures[#failures + 1] = idx .. ': ' .. tostring(object)
                end
            end
        end
        for idx, state in pairs(self.States) do
            if not self.Ignore[idx] then
                local ok, value = pcall(state.Capture)
                if ok and value ~= nil then data.states[idx] = value
                else failures[#failures + 1] = idx .. ': ' .. tostring(value or 'state capture returned nil') end
            end
        end
        table.sort(data.objects, function(a, b) return a.idx < b.idx end)
        self.LastSaveFailures = failures
        return data, failures
    end
    function SaveManager:GetCategory(idx)
        local registry = self.Library and self.Library.ControlRegistry
        if registry and registry[idx] and registry[idx].Category then return registry[idx].Category end
        if idx:find('^shield_') then return 'protection' end
        if idx:find('^SaveManager_') or idx:find('^ui_') or idx:find('^hud_') or idx:find('^settings_') or idx:find('^performance_') or idx:find('^cosmetic_') then return 'interface' end
        for _, word in ipairs({'esp', 'crosshair', 'tracer', 'afterimage', 'target_hud', 'china_hat', 'hit_', 'ambient', 'lighting', 'radar', 'offscreen', 'indicator', 'visual'}) do
            if idx:find(word, 1, true) then return 'visuals' end
        end
        for _, word in ipairs({'desync', 'strafe', 'fly', 'void', 'underground', 'speed', 'jump', 'walk', 'noclip', 'flashback'}) do
            if idx:find(word, 1, true) then return 'movement' end
        end
        return 'other'
    end
    function SaveManager:ReadConfig(name, backup)
        local clean = NormalizeConfigName(name)
        if not clean then return nil, 'select a valid config name' end
        local file = self.Folder .. '/settings/' .. clean .. '.json' .. (backup and '.bak' or '')
        local ok, raw = pcall(readfile, file)
        if not ok then return nil, 'could not read config' end
        local decoded, data = pcall(httpService.JSONDecode, httpService, raw)
        if not decoded then return nil, 'invalid JSON' end
        return self:Migrate(data)
    end
    local function equal(a, b)
        if type(a) ~= type(b) then return false end
        if type(a) ~= 'table' then return a == b end
        for k, v in pairs(a) do if not equal(v, b[k]) then return false end end
        for k in pairs(b) do if a[k] == nil then return false end end
        return true
    end
    function SaveManager:Compare(name)
        local data, err = self:ReadConfig(name)
        if not data then return nil, err end
        local current, changes = {}, {}
        local captured = self:CaptureCurrent()
        for _, object in ipairs(captured.objects) do current[object.idx] = object end
        for idx, value in pairs(type(data.states) == 'table' and data.states or {}) do
            if not equal(captured.states[idx], value) then changes[#changes + 1] = idx .. ': saved state differs' end
        end
        for _, object in ipairs(data.objects) do
            local old = current[object.idx]
            if not old then changes[#changes + 1] = object.idx .. ': missing or ignored'
            else
                local a, b = table.clone(old), table.clone(object)
                a.category, b.category = nil, nil
                if not equal(a, b) then
                    local function value(o)
                        local v = o.key and (o.key .. ' (' .. tostring(o.mode) .. ')') or o.text or o.value
                        if type(v) == 'table' then return httpService:JSONEncode(v) end
                        return tostring(v)
                    end
                    changes[#changes + 1] = object.idx .. ': ' .. value(old) .. ' -> ' .. value(object)
                end
            end
        end
        table.sort(changes)
        return changes
    end
    function SaveManager:Export(name)
        local data, err
        if name then data, err = self:ReadConfig(name) else
            local failures
            data, failures = self:CaptureCurrent()
            if #failures > 0 then return nil, 'failed to capture settings: ' .. table.concat(failures, '; ') end
        end
        if not data then return nil, err end
        local ok, raw = pcall(httpService.JSONEncode, httpService, data)
        if not ok then return nil, 'could not encode config' end
        return raw
    end
    function SaveManager:Import(name, raw)
        local clean = NormalizeConfigName(name)
        if not clean then return false, 'invalid config name' end
        local existsOk, exists = pcall(isfile, self.Folder .. '/settings/' .. clean .. '.json')
        if not existsOk or exists then return false, 'choose a new config name' end
        local ok, data = pcall(httpService.JSONDecode, httpService, raw)
        if not ok then return false, 'invalid JSON' end
        local migrated, err = self:Migrate(data)
        if not migrated then return false, err end
        local encodedOk, encoded = pcall(httpService.JSONEncode, httpService, migrated)
        if not encodedOk then return false, 'could not encode config' end
        local wrote, problem = pcall(writefile, self.Folder .. '/settings/' .. clean .. '.json', encoded)
        return wrote, wrote and nil or tostring(problem)
    end
    function SaveManager:Rename(oldName, newName)
        local old, new = NormalizeConfigName(oldName), NormalizeConfigName(newName)
        if not old or not new or old == new then return false, 'choose two different valid names' end
        local raw, err = self:Export(old)
        if not raw then return false, err end
        local ok, problem = self:Import(new, raw)
        if not ok then return false, problem end
        local removed, removeError = pcall(delfile, self.Folder .. '/settings/' .. old .. '.json')
        if not removed then return false, 'new copy saved; old config could not be removed: ' .. tostring(removeError) end
        local path = self.Folder .. '/settings/autoload.txt'
        local got, autoload = pcall(readfile, path)
        if got and NormalizeConfigName(autoload) == old then
            local updated, updateError = pcall(writefile, path, new)
            if not updated then return false, 'renamed; update autoload: ' .. tostring(updateError) end
            if self.AutoloadLabel then self.AutoloadLabel:SetText('Current autoload config: ' .. new) end
        end
        if self.CurrentConfig == old then self.CurrentConfig = new end
        self:UpdateStatus()
        return true
    end
    function SaveManager:UpdateStatus()
        if not self.StatusLabel then return end
        local dirty = self.Library and self.Library.ConfigDirty
        local saved = self.LastSavedAt and os.date('%H:%M:%S', self.LastSavedAt) or 'never'
        local text = tostring(self.CurrentConfig or 'no config') .. ' | ' .. (dirty and 'unsaved changes' or 'saved') .. '\nlast save: ' .. saved
        local r = self.LastLoadReport
        if r then text ..= string.format('\nloaded %d | missing %d | ignored %d | skipped %d | failed %d', r.Loaded, r.Missing, r.Ignored, r.Skipped, r.Failed) end
        self.StatusLabel:SetText(text)
    end
    function SaveManager:CheckPersistence()
        local encoded, failures = self:CaptureCurrent()
        local count = 0
        for idx in pairs(self.States) do if not self.Ignore[idx] then count += 1 end end
        local seen = {}
        for _, object in ipairs(encoded.objects) do seen[object.idx] = object end
        for idx, control in pairs(getControls()) do
            if type(control) == 'table' and not self.Ignore[idx] then
                count += 1
                if not self.Parser[control.Type] then failures[#failures + 1] = idx .. ': unsupported type'
                elseif not seen[idx] then failures[#failures + 1] = idx .. ': serialization failed'
                elseif control.Type == 'KeyPicker' and (type(seen[idx].key) ~= 'string' or seen[idx].mode ~= control.Mode or not table.find({'Always','Hold','Toggle'},seen[idx].mode)) then failures[#failures + 1] = idx .. ': keybind mismatch'
                elseif control.Type == 'Slider' then
                    local value = tonumber(seen[idx].value)
                    if not value or value ~= value or math.abs(value) == math.huge then failures[#failures + 1] = idx .. ': invalid number' end
                elseif control.Type == 'ColorPicker' then
                    local object = seen[idx]
                    if type(object.value) ~= 'string' or not object.value:match('^%x%x%x%x%x%x$') then failures[#failures + 1] = idx .. ': invalid color' end
                    local alpha = object.transparency
                    if alpha ~= nil and (type(alpha) ~= 'number' or alpha ~= alpha or alpha < 0 or alpha > 1) then failures[#failures + 1] = idx .. ': invalid transparency' end
                elseif control.Type == 'Input' and type(seen[idx].text) ~= 'string' then failures[#failures + 1] = idx .. ': invalid text' end
            end
        end
        local ok, raw = pcall(httpService.JSONEncode, httpService, encoded)
        local decodedOk, decoded = false, nil
        if ok then decodedOk, decoded = pcall(httpService.JSONDecode, httpService, raw) end
        if not decodedOk or not equal(encoded, decoded) then failures[#failures + 1] = 'JSON round trip changed settings' end
        return #failures == 0, count, failures
    end

	function SaveManager:Save(name)
		local clean = NormalizeConfigName(name)
		if (not clean) then
			return false, 'no config file is selected'
		end

		local fullPath = self.Folder .. '/settings/' .. clean .. '.json'

		local data, failures = self:CaptureCurrent()
		if #failures > 0 then return false, 'failed to capture settings: ' .. table.concat(failures, '; ') end

		local success, encoded = pcall(httpService.JSONEncode, httpService, data)
		if not success then
			return false, 'failed to encode data'
		end

		local folderOk, folderError = pcall(function() self:BuildFolderTree() end)
		if not folderOk then return false, 'folder creation failed: ' .. tostring(folderError) end
		local existsOk, exists = pcall(isfile, fullPath)
		if not existsOk then return false, 'failed to check existing config' end
		local previous
		if exists then
			local readOk, raw = pcall(readfile, fullPath)
			if not readOk then return false, 'failed to read existing config' end
			previous = raw
			local decodeOk, oldData = pcall(httpService.JSONDecode, httpService, raw)
			if decodeOk and type(oldData) == 'table' and type(oldData.objects) == 'table' then
				local backupOk, backupError = pcall(writefile, fullPath .. '.bak', raw)
				if not backupOk then return false, 'backup failed: ' .. tostring(backupError) end
			end
		end

		local ok, err = pcall(writefile, fullPath, encoded)
		if not ok then
			if previous then
				local restored = pcall(writefile, fullPath, previous)
				if not restored then return false, 'write failed; restore the .json.bak file before saving again' end
			end
			return false, 'writefile failed: '..tostring(err)
		end
		self.LastSavedAt, self.CurrentConfig = os.time(), clean
		if self.Library then self.Library.ConfigDirty = false end
		self:UpdateStatus()
		return true
	end

	function SaveManager:Load(name, fromBackup, categories)
		local clean = NormalizeConfigName(name)
		if (not clean) then
			return false, 'no config file is selected'
		end

		local file = self.Folder .. '/settings/' .. clean .. '.json'
		if fromBackup then file ..= '.bak' end
		local existsOk, exists = pcall(isfile, file)
		if not existsOk or not exists then
			return false, 'invalid file'
		end

		local readOk, raw = pcall(readfile, file)
		if not readOk then return false, 'read error' end
		local success, decoded = pcall(httpService.JSONDecode, httpService, raw)
		if not success then return false, 'decode error' end
		if type(decoded) ~= 'table' or type(decoded.objects) ~= 'table' then return false, 'decode error' end
		local migrated, migrationError = self:Migrate(decoded)
		if not migrated then return false, migrationError end
		decoded = migrated

        return self:ApplyConfig(decoded, clean, categories)
    end
    function SaveManager:ApplyConfig(decoded, name, categories)
		if self.Loading then return false, 'a config is already loading' end
		local lib = self.Library or (getgenv and getgenv().Library) or Library
		if lib and lib.Unloaded then return false, 'the library is unloaded' end
		self.Loading = true
		local prevSuppress = lib and lib.SuppressSave
		local prevLoading = lib and lib.ConfigLoading
		local safeCallback = lib and lib.SafeCallback
		local updateDependencies = lib and lib.UpdateDependencyBoxes
		local callbacks, errors = {}, {}
		if lib then
			lib.SuppressSave = true
			lib.ConfigLoading = true
			if safeCallback then
				lib.SafeCallback = function(_, callback, ...)
					if callback then callbacks[#callbacks + 1] = {Callback = callback, Arguments = table.pack(...)} end
				end
			end
			if updateDependencies then lib.UpdateDependencyBoxes = function() end end
		end
		if lib and lib.BeforeConfigLoad then pcall(lib.BeforeConfigLoad, decoded, categories) end
        local report = {Loaded = 0, Missing = 0, Ignored = 0, Skipped = 0, Failed = 0, Details = {}}
        self.LastLoadReport = report
        local controls, applied = getControls(), {}
        local function reject(kind, idx, reason)
            report[kind] += 1
            report.Details[#report.Details + 1] = tostring(idx) .. ': ' .. reason
        end
        if decoded.states ~= nil and type(decoded.states) ~= 'table' then
            reject('Failed', 'states', 'invalid persistent states')
        else
            for idx, value in pairs(decoded.states or {}) do
                local state = self.States[idx]
                if type(idx) ~= 'string' or not state then reject('Missing', idx, 'persistent state does not exist')
                elseif self.Ignore[idx] then reject('Ignored', idx, 'excluded from persistence')
                elseif categories and next(categories) and not categories[state.Category] and not table.find(categories, state.Category) then reject('Skipped', idx, 'category not selected')
                else
                    local ok, result, problem = pcall(state.Apply, value)
                    if ok and result ~= false then report.Loaded += 1
                    else reject('Failed', idx, tostring(ok and problem or result)) end
                end
            end
        end
        local function allowed(option)
            local idx = option.idx
            if type(idx) ~= 'string' or not self.Parser[option.type] then reject('Failed', idx, 'unsupported or invalid entry'); return false end
            if self.Ignore[idx] then reject('Ignored', idx, 'excluded from persistence'); return false end
            local control = controls[idx]
            if not control then reject('Missing', idx, 'control does not exist'); return false end
            if control.Type and control.Type ~= option.type then reject('Failed', idx, 'control type mismatch'); return false end
            local category = self:GetCategory(idx)
            if categories and next(categories) and not categories[category] and not table.find(categories, category) then reject('Skipped', idx, 'category not selected'); return false end
            if option.type == 'Slider' and (not tonumber(option.value) or tonumber(option.value) ~= tonumber(option.value) or math.abs(tonumber(option.value)) == math.huge) then reject('Failed', idx, 'invalid numeric value'); return false end
            if option.type == 'ColorPicker' and (type(option.value) ~= 'string' or not option.value:match('^%x%x%x%x%x%x$')) then reject('Failed', idx, 'invalid color'); return false end
            if option.type == 'ColorPicker' then
                local alpha, speed = option.transparency, option.chromaSpeed
                if alpha ~= nil and (type(alpha) ~= 'number' or alpha ~= alpha or alpha < 0 or alpha > 1) then reject('Failed', idx, 'invalid transparency'); return false end
                if speed ~= nil and (type(speed) ~= 'number' or speed ~= speed or speed < 1 or speed > 5) then reject('Failed', idx, 'invalid chroma speed'); return false end
                if option.rgb ~= nil and type(option.rgb) ~= 'boolean' then reject('Failed', idx, 'invalid chroma state'); return false end
            end
            if option.type == 'KeyPicker' and (type(option.key) ~= 'string' or not table.find({'Always','Toggle','Hold'}, option.mode or 'Toggle')) then reject('Failed', idx, 'invalid keybind'); return false end
            if option.type == 'Input' and type(option.text) ~= 'string' then reject('Failed', idx, 'invalid text'); return false end
            if applied[idx] then reject('Skipped', idx, 'duplicate control entry'); return false end
            applied[idx] = true
            return true
        end
        local toggles, keypickers, others, protection = {}, {}, {}, {}
		local protectionMaster = nil
		for _, option in next, decoded.objects do
			if type(option) == 'table' and allowed(option) then
				if option.idx == 'shield_enable' then protectionMaster = option
				elseif option.idx:sub(1, 7) == 'shield_' then table.insert(protection, option)
				elseif option.type == 'Toggle' then table.insert(toggles, option)
				elseif option.type == 'KeyPicker' then table.insert(keypickers, option)
				else table.insert(others, option) end
			end
		end
		local function apply(option)
			local ok, err = pcall(self.Parser[option.type].Load, option.idx, option)
			if not ok then errors[#errors + 1] = option.idx .. ': ' .. tostring(err); reject('Failed', option.idx, tostring(err)) else report.Loaded += 1 end
		end
		for _, option in ipairs(protection) do apply(option) end
		if protectionMaster then apply(protectionMaster) end
		local protectionCallbacks = #callbacks
		for _, group in ipairs({others, keypickers, toggles}) do
			for _, option in ipairs(group) do apply(option) end
		end
		if lib then
			lib.SafeCallback = safeCallback
			lib.UpdateDependencyBoxes = updateDependencies
		end
		local function dispatch(entry)
			task.spawn(function()
				if lib and lib.Unloaded then return end
				local ok, err = pcall(safeCallback, lib, entry.Callback, table.unpack(entry.Arguments, 1, entry.Arguments.n))
				if not ok then
					warn('[Phowg] config callback: ' .. tostring(err))
					if lib and lib.Notify then pcall(lib.Notify, lib, 'Config callback failed: ' .. tostring(err)) end
				end
			end)
		end
		for index = 1, protectionCallbacks do dispatch(callbacks[index]) end
		if lib and lib.AfterProtectionConfigLoad then pcall(lib.AfterProtectionConfigLoad) end
		for index = protectionCallbacks + 1, #callbacks do dispatch(callbacks[index]) end
		if updateDependencies then pcall(updateDependencies, lib) end
		if lib then
			lib.SuppressSave = prevSuppress or false
			lib.ConfigLoading = prevLoading or false
			if lib.AfterConfigLoad then pcall(lib.AfterConfigLoad) end
		end
		self.Loading = false
        self.CurrentConfig = name or self.CurrentConfig
        if lib then lib.ConfigDirty = (categories and next(categories) ~= nil) or report.Failed > 0 or report.Missing > 0 end
        self:UpdateStatus()
		if #errors > 0 then return false, 'failed to load ' .. table.concat(errors, '; ') end
        if report.Failed > 0 then return false, tostring(report.Failed) .. ' invalid config entries; see load report' end

		return true
	end

	function SaveManager:IgnoreThemeSettings()
		self:SetIgnoreIndexes({ 
			"BackgroundColor", "MainColor", "AccentColor", "OutlineColor", "FontColor",
			"ThemeManager_ThemeList", 'ThemeManager_CustomThemeList', 'ThemeManager_CustomThemeName',
		})
	end

	function SaveManager:BuildFolderTree()
		local parts = split(self.Folder, '/')
		local paths = {}
		for idx = 1, #parts do
			paths[#paths + 1] = table.concat(parts, '/', 1, idx)
		end
		table.insert(paths, self.Folder .. '/themes')
		table.insert(paths, self.Folder .. '/settings')

		for i = 1, #paths do
			local str = paths[i]
			local ok, isDir = pcall(isfolder, str)
			if ok and not isDir then
				pcall(makefolder, str)
			elseif not ok then
				pcall(makefolder, str)
			end
		end
	end

	function SaveManager:RefreshConfigList()
		local ok, list = pcall(listfiles, self.Folder .. '/settings')
		if not ok or type(list) ~= 'table' then return {} end

		local out = {}
		for i = 1, #list do
			local file = list[i]
			if type(file) == 'string' and file:sub(-5):lower() == '.json' then
				local name = file:gsub('\\', '/')
				name = name:match("([^/]+)%.json$")
				if name and name ~= '' then
					table.insert(out, name)
				end
			end
		end
		
		return out
	end

	function SaveManager:SetLibrary(library)
		self.Library = library
		library.SaveManager = self
		if getgenv then pcall(function() getgenv().SaveManager = self end) end
		if _G then pcall(function() _G.SaveManager = self end) end
	end

	function SaveManager:LoadAutoloadConfig()
		task.spawn(function()
			local okFile, isFile = pcall(isfile, self.Folder .. '/settings/autoload.txt')
			if not okFile or not isFile then return end
			local okRead, name = pcall(readfile, self.Folder .. '/settings/autoload.txt')
			if not okRead then return end
			local clean = NormalizeConfigName(name)
			if not clean then return end

			-- Wait for UI controls to be registered before applying (max 5 seconds)
			for _ = 1, 50 do
				local t = getToggles()
				local o = getOptions()
				if (t and next(t) ~= nil) or (o and next(o) ~= nil) then
					break
				end
				task.wait(0.1)
			end

			local success, err = self:Load(clean)
			if not success then
				if self.Library then
					self.Library:Notify('Failed to load autoload config: ' .. tostring(err))
				end
				return
			end
			if self.Library then
				self.Library:Notify(string.format('Auto loaded config %q', clean))
			end
		end)
	end

	function SaveManager:BuildConfigSection(tab)
		assert(self.Library, 'Must set SaveManager.Library')

		local section = tab:AddRightGroupbox('Configuration')

		section:AddInput('SaveManager_ConfigName',    { Text = 'Config name' })
		section:AddDropdown('SaveManager_ConfigList', { Text = 'Config list', Values = self:RefreshConfigList(), AllowNull = true })

		section:AddDivider()

		section:AddButton('Create config', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigName and opts.SaveManager_ConfigName.Value) or (Options and Options.SaveManager_ConfigName and Options.SaveManager_ConfigName.Value)
			local clean = NormalizeConfigName(name)

			if not clean then
				return self.Library:Notify('Invalid config name (empty)', 2)
			end

			local success, err = self:Save(clean)
			if not success then
				return self.Library:Notify('Failed to save config: ' .. tostring(err))
			end

			self.Library:Notify(string.format('Created config %q', clean))

			if opts.SaveManager_ConfigList then
				opts.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
				opts.SaveManager_ConfigList:SetValue(nil)
			elseif Options and Options.SaveManager_ConfigList then
				Options.SaveManager_ConfigList:SetValues(self:RefreshConfigList())
				Options.SaveManager_ConfigList:SetValue(nil)
			end
			return nil
		end):AddButton('Load config', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigList and opts.SaveManager_ConfigList.Value) or (Options and Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value)

			local selected = opts.SaveManager_Categories and opts.SaveManager_Categories.Value
            local success, err = self:Load(name, false, selected)
			if not success then
				return self.Library:Notify('Failed to load config: ' .. tostring(err))
			end

			self.Library:Notify(string.format('Loaded config %q', tostring(name)))
			return nil
		end)

		section:AddButton('Overwrite config', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigList and opts.SaveManager_ConfigList.Value) or (Options and Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value)

			local success, err = self:Save(name)
			if not success then
				return self.Library:Notify('Failed to overwrite config: ' .. tostring(err))
			end

			self.Library:Notify(string.format('Overwrote config %q', tostring(name)))
			return nil
		end)

		section:AddButton('Refresh list', function()
			local opts = getOptions()
			local target = (opts and opts.SaveManager_ConfigList) or (Options and Options.SaveManager_ConfigList)
			if target then
				target:SetValues(self:RefreshConfigList())
				target:SetValue(nil)
			end
		end)
		section:AddButton('Load previous save', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigList and opts.SaveManager_ConfigList.Value) or (Options and Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value)
			local success, err = self:Load(name, true)
			if not success then self.Library:Notify('Failed to load backup: ' .. tostring(err)); return end
			self.Library:Notify('Loaded previous save. Use Overwrite config to keep it.')
		end)

		section:AddButton('Set as autoload', function()
			local opts = getOptions()
			local name = (opts.SaveManager_ConfigList and opts.SaveManager_ConfigList.Value) or (Options and Options.SaveManager_ConfigList and Options.SaveManager_ConfigList.Value)
			local clean = NormalizeConfigName(name)
			if not clean then
				return self.Library:Notify('Select a config first', 2)
			end
			writefile(self.Folder .. '/settings/autoload.txt', clean)
			if SaveManager.AutoloadLabel then
				SaveManager.AutoloadLabel:SetText('Current autoload config: ' .. clean)
			end
			self.Library:Notify(string.format('Set %q to auto load', clean))
			return nil
		end)

        section:AddDropdown('SaveManager_Categories', {Text = 'load categories (empty = all)', Values = {'visuals','movement','protection','interface','other'}, Multi = true, AllowNull = true})
        section:AddInput('SaveManager_ImportText', {Text = 'import JSON', Finished = true})
        self.StatusLabel = section:AddLabel('no config | last save: never', true)
        self.DetailLabel = section:AddLabel('', true)
        section:AddButton('Compare selected config', function()
            local opts = getOptions()
            local changes, err = self:Compare(opts.SaveManager_ConfigList.Value)
            self.DetailLabel:SetText(changes and (#changes .. ' differences\n' .. table.concat(changes, '\n')) or tostring(err))
        end)
        section:AddButton('Show load report', function()
            self.DetailLabel:SetText(self.LastLoadReport and table.concat(self.LastLoadReport.Details, '\n') or 'No config loaded yet')
        end)
        section:AddButton('Export selected config', function()
            local raw, err = self:Export(getOptions().SaveManager_ConfigList.Value)
            if raw and setclipboard then local ok = pcall(setclipboard, raw); self.Library:Notify(ok and 'Config copied' or 'Clipboard unavailable')
            else self.Library:Notify(err or 'Clipboard unavailable') end
        end)
        section:AddButton('Import as new config', function()
            local opts = getOptions()
            local ok, err = self:Import(opts.SaveManager_ConfigName.Value, opts.SaveManager_ImportText.Value)
            self.Library:Notify(ok and 'Config imported' or tostring(err))
            if ok then opts.SaveManager_ConfigList:SetValues(self:RefreshConfigList()) end
        end)
        section:AddButton('Rename selected config', function()
            local opts = getOptions()
            local ok, err = self:Rename(opts.SaveManager_ConfigList.Value, opts.SaveManager_ConfigName.Value)
            self.Library:Notify(ok and 'Config renamed' or tostring(err))
            if ok then opts.SaveManager_ConfigList:SetValues(self:RefreshConfigList()); opts.SaveManager_ConfigList:SetValue(nil) end
        end)
        section:AddButton('Check setting persistence', function()
            local ok, count, failures = self:CheckPersistence()
            self.DetailLabel:SetText(ok and (count .. ' controls serialize correctly') or table.concat(failures, '\n'))
        end)
        self:SetIgnoreIndexes({'SaveManager_Categories','SaveManager_ImportText'})
        self:UpdateStatus()

		SaveManager.AutoloadLabel = section:AddLabel('Current autoload config: none', true)

		local okFile, isFile = pcall(isfile, self.Folder .. '/settings/autoload.txt')
		if okFile and isFile then
			local okRead, name = pcall(readfile, self.Folder .. '/settings/autoload.txt')
			if okRead then
				local clean = NormalizeConfigName(name)
				if clean then
					SaveManager.AutoloadLabel:SetText('Current autoload config: ' .. clean)
				end
			end
		end

		SaveManager:SetIgnoreIndexes({ 'SaveManager_ConfigList', 'SaveManager_ConfigName' })
	end

	SaveManager:BuildFolderTree()
end

return SaveManager
